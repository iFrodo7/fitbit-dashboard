# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Fitbit OAuth 2.0 ──────────────────────────────────────
# Crear app en https://dev.fitbit.com/apps/new
# OAuth 2.0 Application Type: Server
# Callback URL: https://tu-app.vercel.app/api/auth/callback
FITBIT_CLIENT_ID=your_fitbit_client_id
FITBIT_CLIENT_SECRET=your_fitbit_client_secret
FITBIT_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ── App ───────────────────────────────────────────────────
NEXTAUTH_SECRET=openssl-rand-base64-32-output-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe (monetización PRO) ─────────────────────────────
# Crear en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Meta Conversions API (server-side Purchase event) ─────
# Pixel ID fijo — no cambiar
META_PIXEL_ID=1401510601815968
# Token: Events Manager → tu Pixel → Settings → Conversions API → Generate access token
META_CAPI_TOKEN=your_meta_capi_token

# ── Web Push / VAPID (#4 server push) ─────────────────────
# Genera las llaves con:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BG...your_public_key
VAPID_PRIVATE_KEY=your_private_key
VAPID_SUBJECT=mailto:tu@email.com
# Secreto para autorizar POST /api/push/send (header x-push-secret)
PUSH_ADMIN_SECRET=openssl-rand-hex-24-output-here
# Secreto del Vercel Cron diario (/api/push/cron-daily). Vercel lo envía como
# Authorization: Bearer $CRON_SECRET. Configúralo en las env de Vercel.
CRON_SECRET=openssl-rand-hex-24-output-here
